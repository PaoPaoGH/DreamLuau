<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>DreamLuau.Godot</PackageId>
    <PackageDescription>Godot .NET bridges and runtime lifecycle integration for DreamLuau.</PackageDescription>
    <PackageTags>luau;lua;scripting;godot;godot4</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DreamLuau/DreamLuau.csproj" />
    <ProjectReference Include="../DreamLuau.NuLua/DreamLuau.NuLua.csproj" />
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>
</Project>
